<workflow name="recap_gen" description="每轮回答完成后异步生成一句话 recap（本地小模型）：user_message+answer 渲染进 LLM 节点 prompt（model=local-qwen）→ ≤30字总结 → 引擎写回 agent._recap（队友可见，不进自己上下文）。turn_end 钩子 + async + recap 三标志" hidden="true">
  <node id="100001" type="start" title="Entry" x="120" y="80">
    <out name="user_message" type="string"/>
    <out name="draft_answer" type="string"/>
    <out name="turn_context" type="string"/>
  </node>
  <node id="120001" type="llm" title="summarize" x="420" y="80">
    <in name="user_message" type="string" ref="100001.user_message"/>
    <in name="answer" type="string" ref="100001.draft_answer"/>
    <in name="turn_ctx" type="string" ref="100001.turn_context"/>
    <param name="temperature" type="string"><![CDATA[0.3]]></param>
    <param name="thinking" type="string"><![CDATA[false]]></param>
    <param name="prompt" type="string"><![CDATA[user message：
{{user_message}}

your answer：
{{answer}}]]></param>
    <param name="systemPrompt" type="string"><![CDATA[You are a summarizer. Summarize in one sentence what you did in this round of conversation (no more than 30 tokens). Only output the sentence itself, without any explanation, quotation marks, prefixes, or special symbols]]></param>
    <param name="output_format" type="string"><![CDATA[text]]></param>
    <model>local-lfm</model>
    <out name="output" type="string"/>
    <batch enabled="false"/>
  </node>
  <node id="900001" type="end" title="Exit" x="720" y="80">
    <out name="result" ref="120001.output" type="string"/>
  </node>
  <edge from="100001" to="120001"/>
  <edge from="120001" to="900001"/>
</workflow>
