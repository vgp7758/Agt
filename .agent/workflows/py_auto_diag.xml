<workflow name="py_auto_diag" description="改 .py 后自动跑 py_diag（after_tool 钩子；基于 changed_files 快照 diff——run_python/MCP 等任何方式改了 .py 都触发；循环遍历+ends_with 过滤+contains 判 ERROR，零 code 节点；需 ensure_lsp('python')）" hook="after_tool" enabled="false">
  <node id="100001" type="start" title="Entry" x="120" y="80">
    <out name="tool_name" type="string"/>
    <out name="tool_args" type="string"/>
    <out name="changed_files" type="list" description="工具调用前后 workspace 快照 diff 的变化文件清单"><field name="file" type="string"/><field name="change" type="string"/></out>
  </node>
  <node id="890541" type="loop" title="loop_changed" x="420" y="80">
    <param name="loopType"><![CDATA[array]]></param>
    <var name="diag" type="string" literal=""/>
    <in name="input" type="list" ref="100001.changed_files"><field name="file" type="string"/><field name="change" type="string"/></in>
    <out name="diag" type="string" description="全量诊断拼接（循环变量终值）" ref="890541.diag"/>
    <out name="all_outputs" type="list" description="所有结果" itemType="string"/>
    <out name="filtered_outputs" type="list" description="筛选结果" itemType="string"/>
    <out name="nth_output" type="string" description="第n个结果"/>
    <blocks>
      <node id="__entry__" type="start" title="迭代入口" x="120" y="80">
    <out name="item" type="object" description="当前元素(整个item)"><field name="file" type="string"/><field name="change" type="string"/></out>
    <out name="index" type="integer" description="当前索引(0起)"/>
    <out name="diag" type="string" description="本地变量(可被置变量修改)"/>
  </node>
      <node id="130041" type="plugin" title="is_py" x="420" y="80" toolName="ends_with">
    <in name="text" type="string" ref="__entry__.item.file"/>
    <in name="suffix" type="string">.py</in>
    <out name="raw" type="boolean"/>
    <batch enabled="false"/>
  </node>
      <node id="130042" type="selector" title="py&amp;not_deleted?" x="720" y="80">
    <branch><cond op="11" left="130041.raw" right="" left_type="boolean"/><cond op="2" left="loop-item.change" right="deleted"/></branch>
  </node>
      <node id="130043" type="plugin" title="py_diag" x="1020" y="80" toolName="__mcp__python-lsp__py_diag">
    <in name="file" type="string" ref="__entry__.item.file"/>
    <out name="raw" type="string"/>
    <batch enabled="false"/>
  </node>
      <node id="130044" type="text" title="report" x="1320" y="80">
    <in name="old" type="string" ref="__entry__.diag"/>
    <in name="file" type="string" ref="__entry__.item.file"/>
    <in name="rep" type="string" ref="130043.raw"/>
    <result><![CDATA[{{old}}📄 {{file}}
{{rep}}
]]></result>
    <batch enabled="false"/>
  </node>
      <node id="130045" type="setvar" title="acc_diag" x="1620" y="80">
    <in name="diag" left="__entry__.diag" left_type="string" right="ref:130044.output" right_type="string"/>
  </node>
      <node id="__continue__" type="continue" title="继续(本轮输出)" x="1920" y="154">
    <in name="result" type="string" ref="130043.raw"/>
    <batch enabled="false"/>
  </node>
      <node id="__break__" type="break" title="中断(Break)" x="1920" y="80"/>
    </blocks>
    <edges>
    <edge source="890541" target="__entry__" sourcePort="loop-function-inline-output"/>
    <edge source="__entry__" target="130041"/>
    <edge source="130041" target="130042"/>
    <edge source="130042" target="130043" sourcePort="true"/>
    <edge source="130043" target="130044"/>
    <edge source="130044" target="130045"/>
    <edge source="130045" target="__continue__"/>
    <edge source="130042" target="__continue__" sourcePort="false"/>
    </edges>
    <batch enabled="false" nth="0"/>
  </node>
  <node id="1079260" type="selector" title="has_diag?" x="712.3998896132788" y="106.60038635352458">
    <branch><cond op="13" left="890541.filtered_outputs.length" right="0" left_type="integer" right_type="integer"/></branch>
  </node>
  <node id="130049" type="plugin" title="has_py" x="860" y="80" toolName="contains">
    <in name="text" type="string" ref="890541.diag"/>
    <in name="keyword" type="string">📄</in>
    <out name="raw" type="boolean"/>
  </node>
  <node id="130050" type="plugin" title="has_error" x="1020" y="80" toolName="contains">
    <in name="text" type="string" ref="890541.diag"/>
    <in name="keyword" type="string">[ERROR]</in>
    <out name="raw" type="boolean"/>
    <out name="result" type="boolean" description="工具返回值"/>
  </node>
  <node id="130060" type="selector" title="error_found?" x="1320" y="80">
    <branch><cond op="11" left="130050.raw" right="" left_type="boolean"/></branch>
  </node>
  <node id="130070" type="text" title="inject_text" x="1620" y="80">
    <in name="diags" type="string" ref="890541.diag"/>
    <result><![CDATA[🐍 Python 诊断发现问题（请修复后再继续）：
{{diags}}]]></result>
  </node>
  <node id="929505" type="text" title="pass_text" x="1620" y="292">
    <result><![CDATA[✅ Python 自动校验语法通过（import/运行仍需另测）]]></result>
  </node>
  <node id="104862" type="aggregator" title="pick" x="1920" y="80">
    <group name="Group1"><var ref="130070.output"/><var ref="929505.output"/></group>
  </node>
  <node id="900001" type="end" title="Exit" x="2377.001379834016" y="120.19718513860661">
    <out name="inject" ref="130049.raw" type="boolean" description="改了 .py = 注入（无论通过/报错）；未改 .py = 不注入（短路路径取不到值）"/>
    <out name="result" ref="104862.Group1" type="string"/>
  </node>
  <edge from="100001" to="890541"/>
  <edge from="890541" to="1079260"/>
  <edge from="1079260" to="130049" port="true"/>
  <edge from="130049" to="130050"/>
  <edge from="130050" to="130060"/>
  <edge from="130060" to="130070" port="true"/>
  <edge from="130060" to="929505" port="false"/>
  <edge from="130070" to="104862"/>
  <edge from="929505" to="104862"/>
  <edge from="104862" to="900001"/>
  <edge from="1079260" to="900001" port="false"/>
</workflow>
