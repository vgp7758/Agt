<workflow name="wiki_auto_query" description="每轮开始前自动查 wiki（Agent 化重构版）：wiki_tree 直接注入 SYSTEM → text+ToJSON+FromJSON 纯节点组装 messages → 工作流内 ReAct 循环（llm_call + wiki_read/wiki_search 两件套）→ 无关问题输出 NO_WIKI_RELEVANT 不注入，相关则注入命中页面摘录（before_turn 钩子，默认开）" hook="before_turn" hidden="true">
  <node id="100001" type="start" title="Entry" x="120" y="80">
    <out name="user_message" type="string" required="true"/>
  </node>
  <node id="110001" type="plugin" title="wiki_tree" x="420" y="80" toolName="wiki_tree">
    <out name="raw" type="string" description="wiki 全库结构（路径+标题大纲）"/>
    <out name="result" type="string" description="工具返回值"/>
    <batch enabled="false"/>
  </node>
  <node id="120001" type="plugin" title="get_wiki_schemas" x="420" y="190" toolName="get_tool_schemas">
    <in name="names" type="string">wiki_read,wiki_search</in>
    <out name="raw" type="list" description="wiki 两件套的 function schema"/>
    <out name="result" type="string" description="工具返回值"/>
    <batch enabled="false"/>
  </node>
  <node id="130001" type="text" title="sys_content" x="720" y="80">
    <in name="tree" type="string" ref="110001.raw"/>
    <result><![CDATA[你是代码仓库的 wiki 检索助手。判断用户问题是否与当前代码仓库（架构/模块/配置/运维/功能）相关：
- 无关（闲聊/通用编程问题/与仓库无关）→ 只输出 NO_WIKI_RELEVANT 七个词，不要调用任何工具。
- 相关 → 先 wiki_search 搜关键词；必要时报 wiki_read 读最相关的 1~2 个页面；然后输出命中清单：每条一行「页面路径：关键内容摘录」，总长 ≤500 字，给主 Agent 做上下文注入用。

【当前 wiki 知识库完整结构】
{{tree}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="130002" type="tojson" title="escape_sys" x="1020" y="80">
    <in name="input" type="string" ref="130001.output"/>
    <out name="output" type="string" description="json.dumps 转义后的合法 JSON 字符串字面量"/>
  </node>
  <node id="130003" type="text" title="sys_json" x="1320" y="80">
    <in name="c" type="string" ref="130002.output"/>
    <result><![CDATA[{"role":"system","content":{{c}}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="130004" type="fromjson" title="sys_msg" x="1620" y="80">
    <in name="input" type="string" ref="130003.output"/>
    <out name="output" type="object"/>
  </node>
  <node id="140001" type="tojson" title="escape_user" x="720" y="292">
    <in name="input" type="string" ref="100001.user_message"/>
    <out name="output" type="string"/>
  </node>
  <node id="140002" type="text" title="user_json" x="1020" y="172">
    <in name="c" type="string" ref="140001.output"/>
    <result><![CDATA[{"role":"user","content":{{c}}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="140003" type="fromjson" title="user_msg" x="1320" y="292">
    <in name="input" type="string" ref="140002.output"/>
    <out name="output" type="object"/>
    <batch enabled="false"/>
  </node>
  <node id="150001" type="plugin" title="append_sys" x="1920" y="80" toolName="list_append">
    <in name="item" type="object" ref="130004.output"/>
    <in name="lst" type="list"></in>
    <out name="raw" type="list"/>
    <out name="result" type="list" description="工具返回值"/>
    <batch enabled="false"/>
  </node>
  <node id="150002" type="plugin" title="append_user" x="2251" y="81" toolName="list_append">
    <in name="lst" type="list" ref="150001.raw"/>
    <in name="item" type="object" ref="140003.output"/>
    <out name="raw" type="list" description="初始 messages=[system,user]"/>
    <out name="result" type="list" description="工具返回值"/>
    <batch enabled="false"/>
  </node>
  <node id="300001" type="loop" title="react_loop" x="2520" y="80">
    <param name="loopType"><![CDATA[infinite]]></param>
    <var name="messages" type="list" ref="150002.raw"/>
    <var name="answer" type="string" literal=""/>
    <in name="tools" type="list" ref="120001.raw"/>
    <out name="answer" type="string" description="最终回答（NO_WIKI_RELEVANT 或 wiki 命中清单）" ref="300001.answer"/>
    <out name="all_outputs" type="list" itemType="string"/>
    <blocks>
      <node id="__entry__" type="start" title="迭代入口" x="120" y="80">
    <out name="index" type="integer" description="当前索引(0起)"/>
    <out name="messages" type="list" description="本地变量(可被置变量修改)"/>
    <out name="answer" type="string" description="本地变量(可被置变量修改)"/>
    <out name="tools" type="list" description="复合节点输入"/>
  </node>
      <node id="310001" type="plugin" title="llm_call" x="420" y="80" toolName="llm_call">
    <in name="messages" type="list" ref="__entry__.messages"/>
    <in name="tools" type="list" ref="__entry__.tools"/>
    <out name="raw" type="object"/>
    <out name="content" type="string"/>
    <out name="tool_calls" type="list"><field name="id" type="string"/><field name="name" type="string"/><field name="arguments" type="object"/></out>
    <out name="error" type="string"/>
    <batch enabled="false"/>
  </node>
      <node id="310002" type="selector" title="has_tool_calls?" x="720" y="80">
    <branch><cond op="13" left="310001.tool_calls.length" right="0" left_type="integer" right_type="integer"/></branch>
  </node>
      <node id="310003" type="plugin" title="call_tool" x="1020" y="80" toolName="call_tool">
    <in name="name" type="string" ref="loop-item.name"/>
    <in name="arguments" type="object" ref="loop-item.arguments"/>
    <out name="raw" type="string"/>
    <batch enabled="true"><input ref="310001.tool_calls" type="list"/></batch>
  </node>
      <node id="310004" type="code" title="append_round" x="1320" y="80">
    <in name="messages" type="list" ref="__entry__.messages"/>
    <in name="resp" type="object" ref="310001.raw"/>
    <in name="tool_results" type="list" ref="310003.all_outputs"/>
    <code language="3"><![CDATA[import json as _j
async def main(args):
    p = args.params
    msgs = list(p.get("messages") or [])
    resp = p.get("resp") or {}
    results = list(p.get("tool_results") or [])   # 批处理 all_outputs：[{raw:...}, ...] 与 tool_calls 按序配对
    tcs = resp.get("tool_calls") or []
    if tcs:
        calls, tools = [], []
        for i, tc in enumerate(tcs):
            fn = tc.get("function") or {}
            name = fn.get("name") or tc.get("name") or "tool"
            a = fn.get("arguments") or tc.get("arguments") or {}
            a_s = a if isinstance(a, str) else _j.dumps(a, ensure_ascii=False)
            cid = tc.get("id") or f"c{i}"
            calls.append({"id": cid, "type": "function", "function": {"name": name, "arguments": a_s}})
            r = results[i] if i < len(results) else None
            tr = r.get("raw") if isinstance(r, dict) else r
            tools.append({"role": "tool", "tool_call_id": cid, "content": str(tr)[:4000]})  # 单结果 4k 上限
        msgs = msgs + [{"role": "assistant", "content": resp.get("content") or None, "tool_calls": calls}] + tools
    return {"messages": msgs}]]></code>
    <out name="messages" type="list"/>
    <batch enabled="false"/>
  </node>
      <node id="310005" type="setvar" title="upd_messages" x="1620" y="80">
    <in name="messages" left="__entry__.messages" left_type="list" right="ref:310004.messages" right_type="list"/>
  </node>
      <node id="__continue__" type="continue" title="继续(本轮输出)" x="1920" y="154">
    <in name="result" type="string" ref="310003.raw"/>
    <batch enabled="false"/>
  </node>
      <node id="310006" type="setvar" title="set_answer" x="1020" y="190">
    <in name="answer" left="__entry__.answer" left_type="string" right="ref:310001.content" right_type="string"/>
  </node>
      <node id="__break__" type="break" title="完成退出" x="1920" y="80"/>
    </blocks>
    <edges>
    <edge source="300001" target="__entry__" sourcePort="loop-function-inline-output"/>
    <edge source="__entry__" target="310001"/>
    <edge source="310001" target="310002"/>
    <edge source="310002" target="310003" sourcePort="true"/>
    <edge source="310003" target="310004"/>
    <edge source="310004" target="310005"/>
    <edge source="310005" target="__continue__"/>
    <edge source="310002" target="310006" sourcePort="false"/>
    <edge source="310006" target="__break__"/>
    </edges>
    <batch enabled="false" nth="0"/>
  </node>
  <node id="400001" type="plugin" title="is_irrelevant" x="2820" y="80" toolName="contains">
    <in name="text" type="string" ref="300001.answer"/>
    <in name="keyword" type="string">NO_WIKI_RELEVANT</in>
    <out name="raw" type="boolean"/>
    <out name="result" type="boolean" description="工具返回值"/>
    <batch enabled="false"/>
  </node>
  <node id="500001" type="selector" title="inject?" x="3120" y="80">
    <branch><cond op="1" left="400001.raw" right="True" left_type="boolean" right_type="boolean"/></branch>
  </node>
  <node id="500005" type="text" title="yes_result" x="3720" y="80">
    <in name="ans" type="string" ref="300001.answer"/>
    <result><![CDATA[📖 相关 wiki（按本轮问题自动检索命中）：
{{ans}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="600001" type="aggregator" title="pick" x="4020" y="80">
    <group name="Group_inject" type="boolean"><var ref="1378610.raw" type="boolean"/><var ref="813874.raw" type="boolean"/></group>
    <group name="Group_result" type="string"><var ref="500005.output" type="string"/><var ref="" type="string"/></group>
  </node>
  <node id="900001" type="end" title="Exit" x="4320" y="80">
    <out name="inject" ref="600001.Group_inject" type="boolean"/>
    <out name="result" ref="600001.Group_result" type="string"/>
  </node>
  <node id="1378610" type="plugin" title="pass_through" x="3420" y="80" toolName="pass_through">
    <in name="input" type="boolean">False</in>
    <out name="raw" type="boolean" description="透传值（结构与输入一致；类型可在编辑器改）"/>
    <batch enabled="false"/>
  </node>
  <node id="813874" type="plugin" title="pass_through" x="3420" y="172" toolName="pass_through">
    <in name="input" type="boolean">True</in>
    <out name="raw" type="boolean" description="透传值（结构与输入一致；类型可在编辑器改）"/>
    <batch enabled="false"/>
  </node>
