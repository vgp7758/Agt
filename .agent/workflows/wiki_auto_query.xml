<workflow name="wiki_auto_query" description="每轮开始前自动查 wiki（Agent 化重构版）：wiki_tree 直接注入 SYSTEM → text+ToJSON+FromJSON 纯节点组装 messages → 工作流内 ReAct 循环（llm_call + wiki_read/wiki_search 两件套）→ 无关问题输出 NO_WIKI_RELEVANT 不注入，相关则注入命中页面摘录（before_turn 钩子，默认关）" hook="before_turn" enabled="false" hidden="true">
  <!-- ===== 入口 ===== -->
  <node id="100001" type="start" title="Entry">
    <out name="user_message" type="string" required="true"/>
  </node>

  <!-- ===== 素材准备：wiki 树 + 工具表（只给 wiki_read/wiki_search 两件套）===== -->
  <node id="110001" type="plugin" title="wiki_tree" toolName="wiki_tree" x="200" y="80">
    <out name="raw" type="string" description="wiki 全库结构（路径+标题大纲）"/>
    <batch enabled="false"/>
  </node>
  <node id="120001" type="plugin" title="get_wiki_schemas" toolName="get_tool_schemas" x="420" y="80">
    <in name="names" type="string">wiki_read,wiki_search</in>
    <out name="raw" type="list" description="wiki 两件套的 function schema"/>
    <batch enabled="false"/>
  </node>

  <!-- ===== SYSTEM 装配：text(人设+tree) → ToJSON(转义) → text(JSON外壳) → FromJSON(转对象) ===== -->
  <!-- 直接 text 拼完整 JSON 会因 tree 里的换行/引号产出非法 JSON；ToJSON 做转义桥 -->
  <node id="130001" type="text" title="sys_content" x="640" y="80">
    <in name="tree" type="string" ref="110001.raw"/>
    <result><![CDATA[你是代码仓库的 wiki 检索助手。判断用户问题是否与当前代码仓库（架构/模块/配置/运维/功能）相关：
- 无关（闲聊/通用编程问题/与仓库无关）→ 只输出 NO_WIKI_RELEVANT 七个词，不要调用任何工具。
- 相关 → 先 wiki_search 搜关键词；必要时报 wiki_read 读最相关的 1~2 个页面；然后输出命中清单：每条一行「页面路径：关键内容摘录」，总长 ≤500 字，给主 Agent 做上下文注入用。

【当前 wiki 知识库完整结构】
{{tree}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="130002" type="tojson" title="escape_sys" x="820" y="80">
    <in name="input" type="string" ref="130001.output"/>
    <out name="output" type="string" description="json.dumps 转义后的合法 JSON 字符串字面量"/>
  </node>
  <node id="130003" type="text" title="sys_json" x="980" y="80">
    <in name="c" type="string" ref="130002.output"/>
    <result><![CDATA[{"role":"system","content":{{c}}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="130004" type="fromjson" title="sys_msg" x="1140" y="80">
    <in name="input" type="string" ref="130003.output"/>
    <out name="output" type="object"/>
  </node>

  <!-- ===== USER 消息装配（同款三步）===== -->
  <node id="140001" type="tojson" title="escape_user" x="1300" y="80">
    <in name="input" type="string" ref="100001.user_message"/>
    <out name="output" type="string"/>
  </node>
  <node id="140002" type="text" title="user_json" x="1440" y="80">
    <in name="c" type="string" ref="140001.output"/>
    <result><![CDATA[{"role":"user","content":{{c}}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="140003" type="fromjson" title="user_msg" x="1580" y="80">
    <in name="input" type="string" ref="140002.output"/>
    <out name="output" type="object"/>
  </node>

  <!-- ===== messages 组装：list_append 纯节点累积（lst 未连线=None 容错为 [item]）===== -->
  <node id="150001" type="plugin" title="append_sys" toolName="list_append" x="1720" y="80">
    <in name="item" type="object" ref="130004.output"/>
    <out name="raw" type="list"/>
    <batch enabled="false"/>
  </node>
  <node id="150002" type="plugin" title="append_user" toolName="list_append" x="1860" y="80">
    <in name="lst" type="list" ref="150001.raw"/>
    <in name="item" type="object" ref="140003.output"/>
    <out name="raw" type="list" description="初始 messages=[system,user]"/>
    <batch enabled="false"/>
  </node>

  <!-- ===== 工作流内 ReAct 循环（骨架同 react_agent_demo，tools 换 wiki 两件套）===== -->
  <node id="300001" type="loop" title="react_loop" x="2100" y="80">
    <param name="loopType"><![CDATA[infinite]]></param>
    <var name="messages" type="list" ref="150002.raw"/>
    <var name="answer" type="string" literal=""/>
    <out name="answer" type="string" description="最终回答（NO_WIKI_RELEVANT 或 wiki 命中清单）" ref="300001.answer"/>
    <out name="all_outputs" type="list" itemType="string"/>
    <blocks>
      <node id="__entry__" type="start" title="迭代入口">
        <out name="index" type="integer"/>
        <out name="messages" type="list" description="累积消息（含工具轮）"/>
        <out name="answer" type="string"/>
      </node>
      <node id="310001" type="plugin" title="llm_call" toolName="llm_call">
        <in name="messages" type="list" ref="__entry__.messages"/>
        <in name="tools" type="list" ref="120001.raw"/>
        <out name="raw" type="object"/>
        <out name="content" type="string"/>
        <out name="tool_calls" type="list"><field name="id" type="string"/><field name="name" type="string"/><field name="arguments" type="object"/></out>
        <out name="error" type="string"/>
        <batch enabled="false"/>
      </node>
      <node id="310002" type="selector" title="has_tool_calls?">
        <branch><cond op="13" left="310001.tool_calls.length" right="0" left_type="integer" right_type="integer"/></branch>
      </node>
      <node id="310003" type="plugin" title="call_tool" toolName="call_tool">
        <in name="name" type="string" ref="310001.tool_calls.0.name"/>
        <in name="arguments" type="object" ref="310001.tool_calls.0.arguments"/>
        <out name="raw" type="string"/>
        <batch enabled="false"/>
      </node>
      <node id="310004" type="code" title="append_round">
        <in name="messages" type="list" ref="__entry__.messages"/>
        <in name="resp" type="object" ref="310001.raw"/>
        <in name="tool_result" type="string" ref="310003.raw"/>
        <code><![CDATA[import json as _j
async def main(args):
    p = args.params
    msgs = list(p.get("messages") or [])
    resp = p.get("resp") or {}
    tr = str(p.get("tool_result") or "")[:4000]   # 单轮工具结果上限（ReAct 上下文管理，防 wiki 长文爆上下文）
    tcs = resp.get("tool_calls") or []
    if tcs:
        tc = tcs[0]
        fn = tc.get("function") or {}
        name = fn.get("name") or tc.get("name") or "tool"
        a = fn.get("arguments") or tc.get("arguments") or {}
        a_s = a if isinstance(a, str) else _j.dumps(a, ensure_ascii=False)
        cid = tc.get("id") or "c0"
        msgs = msgs + [
            {"role": "assistant", "content": resp.get("content") or None,
             "tool_calls": [{"id": cid, "type": "function",
                             "function": {"name": name, "arguments": a_s}}]},
            {"role": "tool", "tool_call_id": cid, "content": tr},
        ]
    return {"messages": msgs}]]></code>
        <out name="messages" type="list"/>
      </node>
      <node id="310005" type="setvar" title="upd_messages">
        <in name="messages" left="__entry__.messages" left_type="list" right="ref:310004.messages" right_type="list"/>
      </node>
      <node id="__continue__" type="continue" title="继续(本轮输出)">
        <in name="result" type="string" ref="310003.raw"/>
        <batch enabled="false"/>
      </node>
      <node id="310006" type="setvar" title="set_answer">
        <in name="answer" left="__entry__.answer" left_type="string" right="ref:310001.content" right_type="string"/>
      </node>
      <node id="__break__" type="break" title="完成退出"/>
    </blocks>
    <edges>
      <edge source="300001" target="__entry__" sourcePort="loop-function-inline-output"/>
      <edge source="__entry__" target="310001"/>
      <edge source="310001" target="310002"/>
      <edge source="310002" target="310003" sourcePort="true"/>
      <edge source="310003" target="310004"/>
      <edge source="310004" target="310005"/>
      <edge source="310005" target="__continue__"/>
      <edge source="310002" target="310006" sourcePort="false"/>
      <edge source="310006" target="__break__"/>
    </edges>
    <batch enabled="false" nth="0"/>
  </node>

  <!-- ===== 相关性裁决：无关（NO_WIKI_RELEVANT）→ 不注入；相关 → 注入命中清单 ===== -->
  <node id="400001" type="plugin" title="is_irrelevant" toolName="contains" x="2380" y="80">
    <in name="text" type="string" ref="300001.answer"/>
    <in name="keyword" type="string">NO_WIKI_RELEVANT</in>
    <out name="raw" type="boolean"/>
    <batch enabled="false"/>
  </node>
  <node id="500001" type="selector" title="inject?" x="2560" y="80">
    <in name="irr" type="boolean" ref="400001.raw"/>
    <branch><cond op="1" left="400001.raw" right="true" left_type="boolean" right_type="boolean"/></branch>
  </node>
  <node id="500002" type="text" title="no_inject" x="2740" y="20">
    <result><![CDATA[false]]></result>
    <batch enabled="false"/>
  </node>
  <node id="500004" type="text" title="no_result" x="2900" y="20">
    <result><![CDATA[]]></result>
    <batch enabled="false"/>
  </node>
  <node id="500003" type="text" title="yes_inject" x="2740" y="140">
    <result><![CDATA[true]]></result>
    <batch enabled="false"/>
  </node>
  <node id="500005" type="text" title="yes_result" x="2900" y="140">
    <in name="ans" type="string" ref="300001.answer"/>
    <result><![CDATA[📖 相关 wiki（按本轮问题自动检索命中）：
{{ans}}]]></result>
    <batch enabled="false"/>
  </node>
  <node id="600001" type="aggregator" title="pick" x="3080" y="80">
    <group name="Group_inject"><var ref="500002.output"/><var ref="500003.output"/></group>
    <group name="Group_result"><var ref="500004.output"/><var ref="500005.output"/></group>
  </node>

  <node id="900001" type="end" title="Exit" x="3260" y="80">
    <out name="inject" ref="600001.Group_inject" type="boolean"/>
    <out name="result" ref="600001.Group_result" type="string"/>
  </node>

  <!-- ===== 边（串行链保证 DAG 顺序；ref 只是取值，顺序靠边）===== -->
  <edge from="100001" to="110001"/>
  <edge from="110001" to="120001"/>
  <edge from="120001" to="130001"/>
  <edge from="130001" to="130002"/>
  <edge from="130002" to="130003"/>
  <edge from="130003" to="130004"/>
  <edge from="130004" to="150001"/>
  <edge from="150001" to="140001"/>
  <edge from="140001" to="140002"/>
  <edge from="140002" to="140003"/>
  <edge from="140003" to="150002"/>
  <edge from="150002" to="300001"/>
  <edge from="300001" to="400001"/>
  <edge from="400001" to="500001"/>
  <edge from="500001" to="500002" port="true"/>
  <edge from="500002" to="500004"/>
  <edge from="500001" to="500003" port="false"/>
  <edge from="500003" to="500005"/>
  <edge from="500004" to="600001"/>
  <edge from="500005" to="600001"/>
  <edge from="600001" to="900001"/>
</workflow>
