<workflow name="wiki_auto_maintenance" description="最终回答前自动维护 wiki：判断是否值得记录→调 update_wiki 子 Agent 维护→用报告摘要拼 commit message→检查 wiki 变更并自动提交推送→报告发系统消息（不喂主 LLM，before_answer 钩子，默认关）" hook="before_answer" hidden="true" async="true">
  <node id="100001" type="start" title="start" x="120" y="80">
    <out name="user_message" type="string"/>
    <out name="draft_answer" type="string"/>
    <out name="turn_context" type="string"/>
  </node>
  <node id="110001" type="llm" title="llm" x="420" y="80">
    <in name="user_message" type="string" ref="100001.user_message"/>
    <in name="draft_answer" type="string" ref="100001.draft_answer"/>
    <in name="turn_context" type="string" ref="100001.turn_context"/>
    <param name="systemPrompt" type="string"><![CDATA[你是 repo-wiki 维护判官。判断本轮对话是否值得记录进项目知识库（.agent/wiki/）。
值得记录：实现了新功能、修复了 bug、做出架构/设计决策、摸清了某模块的工作原理、解决了值得备忘的问题。
不值得记录：纯闲聊、简单问答、查询信息、未产生可复用知识。
只输出一个 JSON 对象，不要 markdown：
{"needs_maintenance": true, "summary": "本轮做了什么、影响哪些模块、关键结论"}
needs_maintenance=false 时 summary 给空串。summary 要聚焦改动，简洁（交由后续子 Agent 据此 wiki_tree/wiki_read 后 wiki_write）。]]></param>
    <param name="prompt" type="string"><![CDATA[用户任务：
{{user_message}}

本轮工具调用（做了什么）：
{{turn_context}}

主 Agent 最终回答：
{{draft_answer}}]]></param>
    <param name="temperature" type="float"><![CDATA[0.2]]></param>
    <out name="needs_maintenance" type="boolean"/>
    <out name="summary" type="string"/>
    <out name="output" type="string"/>
  </node>
  <node id="130001" type="selector" title="selector" x="720" y="80">
    <branch><cond op="1" left="110001.needs_maintenance" right="True" left_type="boolean" right_type="boolean"/></branch>
  </node>
  <node id="140001" type="plugin" title="update_wiki" x="1020" y="80" toolName="update_wiki">
    <in name="summary" type="string" ref="110001.summary"/>
    <out name="raw" type="string"/>
    <out name="result" type="string" description="工具返回值"/>
  </node>
  <node id="868393" type="text" title="build_commit_msg" x="1250" y="80">
    <in name="info" type="string" ref="140001.raw"/>
    <result><![CDATA[git add .agent/wiki/ && (git diff --cached --quiet || (git commit -m "docs: wiki auto-maintenance — {{info}}" && git push))]]></result>
    <out name="output" type="string"/>
  </node>
  <node id="150001" type="plugin" title="commit_wiki" x="1520" y="80" toolName="run_shell">
    <in name="command" type="string" ref="868393.output"/>
    <out name="raw" type="string"/>
    <out name="result" type="string"/>
  </node>
  <node id="900001" type="end" title="end" x="1820" y="80">
    <out name="inject" type="boolean">False</out>
    <out name="message" ref="140001.raw" type="string"/>
  </node>
  <edge from="100001" to="110001"/>
  <edge from="110001" to="130001"/>
  <edge from="130001" to="140001" port="true"/>
  <edge from="140001" to="868393"/>
  <edge from="868393" to="150001"/>
  <edge from="150001" to="900001"/>
  <edge from="130001" to="900001" port="false"/>
</workflow>
