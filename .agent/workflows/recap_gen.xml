<workflow name="recap_gen" description="每轮回答完成后异步生成一句话 recap（本地小模型）：user_message+answer 渲染进 LLM 节点 prompt（model=local-qwen）→ ≤30字总结 → 引擎写回 agent._recap（队友可见，不进自己上下文）。turn_end 钩子 + async + recap 三标志" hidden="true">
  <node id="100001" type="start" title="Entry" x="120" y="80">
    <out name="user_message" type="string"/>
    <out name="draft_answer" type="string"/>
    <out name="turn_context" type="string"/>
  </node>
  <node id="120001" type="llm" title="summarize" x="420" y="80">
    <in name="user_message" ref="100001.user_message"/>
    <in name="answer" ref="100001.draft_answer"/>
    <in name="turn_ctx" ref="100001.turn_context"/>
    <param name="model"><![CDATA[local-qwen]]></param>
    <param name="temperature"><![CDATA[0.3]]></param>
    <param name="thinking"><![CDATA[false]]></param>
    <param name="prompt"><![CDATA[用一句话（不超过30个中文字）总结这轮对话做了什么。只输出这句话本身，不要任何解释、引号或前缀。
用户请求：{{user_message}}
回答节选：{{answer}}]]></param>
    <out name="output" type="string"/>
  </node>
  <node id="900001" type="end" title="Exit" x="720" y="80">
    <out name="result" ref="120001.output" type="string"/>
  </node>
  <edge from="100001" to="120001"/>
  <edge from="120001" to="900001"/>
</workflow>
